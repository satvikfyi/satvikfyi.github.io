---
/**
 * Tag, a small label pill (filters, dosha tags, module status, …).
 */
import { accentTag } from './accents';
import type { AccentToken } from '../../config/module';

interface Props {
  label: string;
  accent?: AccentToken;
}

const { label, accent = 'sage' } = Astro.props;
---

<span class:list={['inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium', accentTag[accent]]}>
  {label}
</span>
