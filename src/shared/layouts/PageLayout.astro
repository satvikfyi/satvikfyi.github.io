---
/**
 * PageLayout, a standard content page: BaseLayout plus a page header
 * (eyebrow / title / lede) and a centered container.
 */
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import type { JsonLdObject } from '../seo/jsonld';
import type { AccentToken } from '../../config/module';

interface Props {
  title: string;
  description?: string;
  /** Page H1; defaults to `title`. */
  heading?: string;
  eyebrow?: string;
  lede?: string;
  path: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: JsonLdObject[];
  /** Accent for the page header (defaults to saffron). */
  accent?: AccentToken;
  /** Extra classes for the content container (e.g. prose customization). */
  containerClass?: string;
}

const {
  title,
  description,
  heading,
  eyebrow,
  lede,
  path,
  type,
  noindex,
  jsonLd,
  accent = 'saffron',
  containerClass = '',
} = Astro.props;
---

<BaseLayout title={title} description={description} path={path} type={type} noindex={noindex} jsonLd={jsonLd}>
  <div class={`mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 ${containerClass}`}>
    <PageHeader eyebrow={eyebrow} title={heading ?? title} description={lede} accent={accent} />
    <slot />
  </div>
</BaseLayout>
