---
/**
 * Yoga module listing, every pose rendered in HTML (the no-JS fallback IS
 * this page), with a self-contained filter island layered on top. Zero JS
 * unless the island loads.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../../../shared/layouts/PageLayout.astro';
import Disclaimer from '../../../../shared/components/Disclaimer.astro';
import { websiteJsonLd, breadcrumbJsonLd } from '../../../../shared/seo/jsonld';
import { SITE } from '../../../../config/site';
import { isModuleEnabled } from '../../../../config/sections';
import PoseCard from '../components/PoseCard.astro';
import config from '../module.config';
import { DOSHAS, POSE_CATEGORIES, POSE_LEVELS, doshaLabel, poseCategoryLabel, poseLevelLabel } from '../lib/domain';

const entries = await getCollection('yoga-poses');
const poses = entries
  .map((entry) => entry.data)
  .sort((a, b) => a.category.localeCompare(b.category, 'en') || a.name.localeCompare(b.name, 'en'));

const usedCategories = POSE_CATEGORIES.filter((category) => poses.some((p) => p.category === category));
const usedLevels = POSE_LEVELS.filter((level) => poses.some((p) => p.level === level));
const countByCategory = usedCategories.map((category) => ({
  category,
  count: poses.filter((p) => p.category === category).length,
}));
---

<PageLayout
  title={config.title}
  description={config.description}
  heading="Yogasana"
  eyebrow="Body · Yoga"
  lede={`${poses.length} classical asanas with Sanskrit names in IAST, step-by-step guidance, benefits, contraindications and the doshas each pose traditionally helps balance; sourced from the hatha tradition and respected modern teachers.`}
  path={config.routePrefix}
  accent="saffron"
  jsonLd={[
    websiteJsonLd(SITE),
    breadcrumbJsonLd(SITE.url, [
      { name: 'Home', path: '/' },
      { name: 'Body', path: '/body/' },
      { name: config.title, path: config.routePrefix },
    ]),
  ]}
>
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div id="pose-filters" hidden class="mb-6 rounded-2xl border border-sand bg-parchment/60 p-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <label for="filter-dosha" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Dosha</label>
            <select id="filter-dosha" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any dosha</option>
              {DOSHAS.map((dosha) => (
                <option value={dosha}>Balances {doshaLabel[dosha]}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-category" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Category</label>
            <select id="filter-category" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any category</option>
              {usedCategories.map((category) => (
                <option value={category}>{poseCategoryLabel[category]}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-level" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Level</label>
            <select id="filter-level" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any level</option>
              {usedLevels.map((level) => (
                <option value={level}>{poseLevelLabel[level]}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="mt-4 flex items-center justify-between gap-4">
          <p id="pose-count" role="status" aria-live="polite" class="text-sm text-clay">
            Showing all {poses.length} poses
          </p>
          <button
            type="button"
            id="filter-clear"
            class="rounded-lg border border-sand bg-cream px-3 py-1.5 text-xs font-semibold text-earth transition-colors hover:border-saffron/60 hover:text-saffron-deep disabled:cursor-not-allowed disabled:opacity-50"
          >
            Clear filters
          </button>
        </div>
        <p id="quiz-applied-note" hidden class="mt-2 text-xs leading-relaxed text-clay">
          Filtered to your saved dosha-quiz result, adjust the dosha above, or retake the quiz to change it.
        </p>
      </div>

      <noscript>
        <p class="mb-6 rounded-2xl border border-sand bg-parchment/60 p-4 text-sm leading-relaxed text-clay">
          JavaScript is off, so all {poses.length} poses are listed below, browse the full collection.
        </p>
      </noscript>

      <ul id="pose-grid" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {poses.map((pose) => <PoseCard pose={pose} />)}
      </ul>

      <div class="mt-10">
        <Disclaimer variant="yoga" />
      </div>
    </div>

    <aside class="h-fit space-y-6 lg:sticky lg:top-6">
      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">Which poses suit you?</h2>
        <p class="mt-2 text-sm leading-relaxed text-clay">
          Not sure of your dominant dosha? A short questionnaire reflects on body, energy and mind and
          saves the result on this device only, the filters here and the meal planner pick it up
          automatically.
        </p>
        {isModuleEnabled('quiz') && (
          <a
            href="/quiz/"
            class="mt-4 inline-block rounded-xl bg-saffron-deep px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-earth"
          >
            Take the dosha quiz
          </a>
        )}
      </div>

      {isModuleEnabled('meals') && (
        <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
          <h2 class="font-display text-base font-semibold text-earth">Eat for the same balance</h2>
          <p class="mt-2 text-sm leading-relaxed text-clay">
            Poses work best alongside food that soothes the same dosha, the recipe collection filters
            the same way.
          </p>
          <ul role="list" class="mt-4 space-y-1.5 text-sm">
            {DOSHAS.map((dosha) => (
              <li>
                <a
                  href={`/body/meals/?dosha=${dosha}`}
                  class="font-medium text-saffron-deep underline decoration-saffron/60 underline-offset-2 hover:decoration-saffron-deep"
                >
                  Recipes balancing {doshaLabel[dosha]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">By category</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {
            countByCategory.map(({ category, count }) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-clay">{poseCategoryLabel[category]}</dt>
                <dd class="font-semibold text-earth">{count}</dd>
              </div>
            ))
          }
          <div class="flex items-baseline justify-between gap-4 border-t border-sand pt-2">
            <dt class="text-clay">Total</dt>
            <dd class="font-semibold text-earth">{poses.length}</dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</PageLayout>

<script>
  import { mountPoseFilters } from '../components/PoseFilters';
  mountPoseFilters(document.getElementById('pose-filters'));
</script>
