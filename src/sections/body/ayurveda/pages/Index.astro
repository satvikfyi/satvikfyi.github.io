---
/**
 * Ayurveda module listing, every herb and ingredient rendered in HTML (the
 * no-JS fallback IS this page), with a self-contained filter island layered
 * on top. Zero JS unless the island loads.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../../../shared/layouts/PageLayout.astro';
import Disclaimer from '../../../../shared/components/Disclaimer.astro';
import { websiteJsonLd, breadcrumbJsonLd } from '../../../../shared/seo/jsonld';
import { SITE } from '../../../../config/site';
import { isModuleEnabled } from '../../../../config/sections';
import EntryCard from '../components/EntryCard.astro';
import config from '../module.config';
import { DOSHAS, ENTRY_KINDS, doshaLabel, entryKindLabel } from '../lib/domain';

const entries = await getCollection('ayurveda-entries');
const items = entries
  // Entries migrated to the wiki render redirect stubs at their URLs but
  // no longer appear in the listing.
  .filter((entry) => !entry.data.movedTo)
  .map((entry) => entry.data)
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));

const countByKind = ENTRY_KINDS.map((kind) => ({
  kind,
  count: items.filter((e) => e.kind === kind).length,
}));
---

<PageLayout
  title={config.title}
  description={config.description}
  heading="Ayurveda, Herbs & Ingredients"
  eyebrow="Body · Ayurveda"
  lede={`${items.length} herbs and kitchen ingredients with their classical ayurvedic energetics, taste, heating or cooling nature, dosha effects, traditional uses and honest cautions; each cited to classical texts or respected modern references.`}
  path={config.routePrefix}
  accent="saffron"
  jsonLd={[
    websiteJsonLd(SITE),
    breadcrumbJsonLd(SITE.url, [
      { name: 'Home', path: '/' },
      { name: 'Body', path: '/body/' },
      { name: config.title, path: config.routePrefix },
    ]),
  ]}
>
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div id="entry-filters" hidden class="mb-6 rounded-2xl border border-sand bg-parchment/60 p-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="filter-dosha" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Dosha</label>
            <select id="filter-dosha" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any dosha</option>
              {DOSHAS.map((dosha) => (
                <option value={dosha}>Balances {doshaLabel[dosha]}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-kind" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Type</label>
            <select id="filter-kind" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Herbs &amp; ingredients</option>
              {countByKind.filter(({ count }) => count > 0).map(({ kind }) => (
                <option value={kind}>{entryKindLabel[kind]}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="mt-4 flex items-center justify-between gap-4">
          <p id="entry-count" role="status" aria-live="polite" class="text-sm text-clay">
            Showing all {items.length} entries
          </p>
          <button
            type="button"
            id="filter-clear"
            class="rounded-lg border border-sand bg-cream px-3 py-1.5 text-xs font-semibold text-earth transition-colors hover:border-saffron/60 hover:text-saffron-deep disabled:cursor-not-allowed disabled:opacity-50"
          >
            Clear filters
          </button>
        </div>
        <p id="quiz-applied-note" hidden class="mt-2 text-xs leading-relaxed text-clay">
          Filtered to your saved dosha-quiz result, adjust the dosha above, or retake the quiz to change it.
        </p>
      </div>

      <noscript>
        <p class="mb-6 rounded-2xl border border-sand bg-parchment/60 p-4 text-sm leading-relaxed text-clay">
          JavaScript is off, so all {items.length} entries are listed below, browse the full collection.
        </p>
      </noscript>

      <p class="mb-4 text-xs leading-relaxed text-clay">
        Reading the chips: <strong class="font-semibold text-earth">vāta +</strong> means the entry
        traditionally balances vāta · <strong class="font-semibold text-earth">·</strong> means neutral ·
        <strong class="font-semibold text-earth">−</strong> means it can aggravate that dosha.
      </p>

      <ul id="entry-grid" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {items.map((item) => <EntryCard entry={item} />)}
      </ul>

      <div class="mt-10">
        <Disclaimer variant="ayurveda" />
      </div>
    </div>

    <aside class="h-fit space-y-6 lg:sticky lg:top-6">
      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">Know your dosha first</h2>
        <p class="mt-2 text-sm leading-relaxed text-clay">
          Energetics only make sense against your own constitution. The dosha quiz reflects on body,
          energy and mind, and saves the result on this device only; the filters here, the poses and
          the meal planner all pick it up automatically.
        </p>
        {isModuleEnabled('quiz') && (
          <a
            href="/quiz/"
            class="mt-4 inline-block rounded-xl bg-saffron-deep px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-earth"
          >
            Take the dosha quiz
          </a>
        )}
      </div>

      {isModuleEnabled('yoga') && (
        <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
          <h2 class="font-display text-base font-semibold text-earth">Move for the same balance</h2>
          <p class="mt-2 text-sm leading-relaxed text-clay">
            The asana database filters by dosha the same way, poses and herbs are traditionally used
            together.
          </p>
          <ul role="list" class="mt-4 space-y-1.5 text-sm">
            {DOSHAS.map((dosha) => (
              <li>
                <a
                  href={`/body/yoga/?dosha=${dosha}`}
                  class="font-medium text-saffron-deep underline decoration-saffron/60 underline-offset-2 hover:decoration-saffron-deep"
                >
                  Poses balancing {doshaLabel[dosha]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">In the collection</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {
            countByKind.map(({ kind, count }) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-clay">{entryKindLabel[kind]}</dt>
                <dd class="font-semibold text-earth">{count}</dd>
              </div>
            ))
          }
          <div class="flex items-baseline justify-between gap-4 border-t border-sand pt-2">
            <dt class="text-clay">Total</dt>
            <dd class="font-semibold text-earth">{items.length}</dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</PageLayout>

<script>
  import { mountEntryFilters } from '../components/EntryFilters';
  mountEntryFilters(document.getElementById('entry-filters'));
</script>
