---
/**
 * Technique detail, steps, rhythm & duration, benefits, contraindications
 * (mandatory, prominently rendered), a teacher-required banner for advanced
 * practices, sources and the shared pranayama safety disclaimer.
 * Routed via src/pages/mind/pranayama/[slug].astro (thin wrapper).
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageLayout from '../../../../shared/layouts/PageLayout.astro';
import Disclaimer from '../../../../shared/components/Disclaimer.astro';
import Tag from '../../../../shared/components/Tag.astro';
import ExternalLink from '../../../../shared/components/ExternalLink.astro';
import YouTubeEmbed from '../../../../shared/components/YouTubeEmbed.astro';
import { breadcrumbJsonLd } from '../../../../shared/seo/jsonld';
import { SITE } from '../../../../config/site';
import { isModuleEnabled } from '../../../../config/sections';
import config from '../module.config';
import { techniqueJsonLd } from '../lib/jsonld';
import { categoryLabel, doshaLabel, levelLabel, youtubeId } from '../lib/domain';

export async function getStaticPaths() {
  if (!isModuleEnabled('pranayama')) return [];
  const entries = await getCollection('pranayama-techniques');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'pranayama-techniques'>;
}

const { entry } = Astro.props;
const technique = entry.data;
const { Content } = await render(entry);
const hasBody = typeof entry.body === 'string' && entry.body.trim().length > 0;
const path = `/mind/pranayama/${technique.slug}/`;

const video = technique.videoUrl ? youtubeId(technique.videoUrl) : null;
const related = (await getCollection('pranayama-techniques'))
  .map((e) => e.data)
  .filter((t) => t.slug !== technique.slug && t.category === technique.category)
  .sort((a, b) => a.name.localeCompare(b.name, 'en'))
  .slice(0, 3);
---

<PageLayout
  title={`${technique.name} (${technique.sanskritName})`}
  description={technique.summary}
  heading={technique.name}
  eyebrow={`Mind · Breath · ${categoryLabel[technique.category]}`}
  path={path}
  type="article"
  accent="indigo"
  jsonLd={[
    techniqueJsonLd({ technique, siteUrl: SITE.url, path, siteName: SITE.name }),
    breadcrumbJsonLd(SITE.url, [
      { name: 'Home', path: '/' },
      { name: 'Mind', path: '/mind/' },
      { name: config.title, path: config.routePrefix },
      { name: technique.name, path },
    ]),
  ]}
>
  <nav aria-label="Breadcrumb" class="mb-6">
    <ol class="flex flex-wrap items-center gap-2 text-sm text-clay">
      <li><a href="/" class="hover:text-saffron-deep hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/mind/" class="hover:text-saffron-deep hover:underline">Mind</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/mind/pranayama/" class="hover:text-saffron-deep hover:underline">Pranayama</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="font-medium text-earth">{technique.name}</li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
    <article class="lg:col-span-2">
      <p class="font-display text-xl text-clay italic">{technique.sanskritName}</p>
      <p class="mt-4 text-lg leading-relaxed text-clay">{technique.summary}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <Tag label={categoryLabel[technique.category]} accent="indigo" />
        <Tag label={levelLabel[technique.level]} />
        {technique.requiresTeacher && <Tag label="Learn with a teacher" accent="plum" />}
        {technique.associatedDoshas.map((dosha) => (
          <Tag label={`Balances ${doshaLabel[dosha]}`} accent="sage" />
        ))}
      </div>

      {
        technique.requiresTeacher && (
          <aside
            role="note"
            aria-label="Learn from a teacher"
            class="mt-8 rounded-2xl border-2 border-plum/50 bg-plum/10 p-5 text-sm leading-relaxed text-earth"
          >
            <p class="mb-1 font-semibold text-plum-deep">This practice is learned from a teacher</p>
            <p>
              The haṭha tradition is explicit that forceful breathwork belongs under supervision. This
              page describes the technique for understanding; find a qualified teacher before practising it.
            </p>
          </aside>
        )
      }

      <section aria-labelledby="steps-heading" class="mt-10">
        <h2 id="steps-heading" class="font-display text-2xl font-bold text-earth">How to practise</h2>
        <ol role="list" class="mt-4 space-y-4">
          {
            technique.steps.map((step, index) => (
              <li class="flex gap-4">
                <span
                  aria-hidden="true"
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-indigo/15 text-sm font-bold text-indigo-deep"
                >
                  {index + 1}
                </span>
                <p class="text-sm leading-relaxed text-earth">{step}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="benefits-heading" class="mt-10">
        <h2 id="benefits-heading" class="font-display text-2xl font-bold text-earth">Benefits</h2>
        <ul role="list" class="mt-4 grid grid-cols-1 gap-2 rounded-2xl border border-sand bg-parchment/60 p-6 sm:grid-cols-2">
          {
            technique.benefits.map((benefit) => (
              <li class="flex gap-2 text-sm leading-relaxed text-earth">
                <span aria-hidden="true" class="mt-0.5 text-sage-deep">◆</span>
                <span>{benefit}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="contra-heading" class="mt-10">
        <h2 id="contra-heading" class="font-display text-2xl font-bold text-earth">Contraindications &amp; cautions</h2>
        <ul role="list" class="mt-4 space-y-2 rounded-2xl border border-plum/30 bg-plum/5 p-6">
          {
            technique.contraindications.map((caution) => (
              <li class="flex gap-2 text-sm leading-relaxed text-earth">
                <span aria-hidden="true" class="mt-0.5 font-bold text-plum-deep">!</span>
                <span>{caution}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-clay">
          If you are pregnant, or live with a cardiac, respiratory or mental-health condition, consult a
          qualified teacher and a physician before practising. Never strain the breath.
        </p>
      </section>

      {
        video && (
          <section aria-labelledby="video-heading" class="mt-10">
            <h2 id="video-heading" class="font-display text-2xl font-bold text-earth">Watch a free guide</h2>
            <p class="mt-2 mb-4 text-sm leading-relaxed text-clay">
              A free video walkthrough, loaded only when you scroll to it, via YouTube's
              privacy-enhanced player.
            </p>
            <YouTubeEmbed videoId={video} title={`${technique.name} (${technique.sanskritName}), free video guide`} />
          </section>
        )
      }

      {
        hasBody && (
          <section aria-labelledby="tradition-heading" class="mt-10">
            <h2 id="tradition-heading" class="font-display text-2xl font-bold text-earth">In the tradition</h2>
            <div class="prose prose-earth mt-4 max-w-none prose-headings:font-display prose-a:text-saffron-deep">
              <Content />
            </div>
          </section>
        )
      }

      {
        technique.sources.length > 0 && (
          <section aria-labelledby="sources-heading" class="mt-10">
            <h2 id="sources-heading" class="font-display text-2xl font-bold text-earth">Sources &amp; further reading</h2>
            <ul role="list" class="mt-4 space-y-2 text-sm leading-relaxed text-clay">
              {technique.sources.map((source) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="mt-0.5 text-indigo-deep">◆</span>
                  <span>
                    {source.url ? (
                      <ExternalLink href={source.url} class="font-medium text-saffron-deep underline decoration-saffron/60 underline-offset-2">
                        {source.title}
                      </ExternalLink>
                    ) : (
                      <span class="font-medium text-earth">{source.title}</span>
                    )}
                    {source.author && <span>, {source.author}</span>}
                    {source.reference && <span class="italic"> ({source.reference})</span>}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-10">
        <Disclaimer variant="pranayama" />
      </div>
    </article>

    <aside class="h-fit space-y-6 lg:sticky lg:top-6">
      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">Rhythm &amp; duration</h2>
        <p class="mt-3 text-sm leading-relaxed text-earth">{technique.rhythm}</p>
        <p class="mt-3 text-sm leading-relaxed text-clay">{technique.durationGuidance}</p>
        <p class="mt-3 text-xs leading-relaxed text-clay">
          Counts are guidance, not law; comfort governs every round.
        </p>
      </div>

      {related.length > 0 && (
        <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
          <h2 class="font-display text-base font-semibold text-earth">More {categoryLabel[technique.category].toLowerCase()} breaths</h2>
          <ul role="list" class="mt-3 space-y-2 text-sm">
            {
              related.map((other) => (
                <li>
                  <a
                    href={`/mind/pranayama/${other.slug}/`}
                    class="font-medium text-earth underline decoration-indigo/60 underline-offset-2 hover:decoration-indigo-deep"
                  >
                    {other.name}
                  </a>
                  <span class="text-clay"> · {other.sanskritName}</span>
                </li>
              ))
            }
          </ul>
          <a href="/mind/pranayama/" class="mt-4 inline-block text-sm font-semibold text-indigo-deep underline decoration-indigo/60 underline-offset-4 hover:decoration-indigo-deep">
            Browse all techniques
          </a>
        </div>
      )}
    </aside>
  </div>
</PageLayout>
