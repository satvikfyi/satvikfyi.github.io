---
/**
 * Pranayama module listing, every technique rendered in HTML (the no-JS
 * fallback IS this page), with a self-contained filter island layered on
 * top. Safety framing is part of the page itself, not an afterthought.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../../../shared/layouts/PageLayout.astro';
import Disclaimer from '../../../../shared/components/Disclaimer.astro';
import { websiteJsonLd, breadcrumbJsonLd } from '../../../../shared/seo/jsonld';
import { SITE } from '../../../../config/site';
import { isModuleEnabled } from '../../../../config/sections';
import TechniqueCard from '../components/TechniqueCard.astro';
import config from '../module.config';
import {
  DOSHAS,
  PRANAYAMA_CATEGORIES,
  PRANAYAMA_LEVELS,
  categoryLabel,
  doshaLabel,
  levelLabel,
} from '../lib/domain';

const entries = await getCollection('pranayama-techniques');
const techniques = entries
  .map((entry) => entry.data)
  .sort(
    (a, b) =>
      PRANAYAMA_LEVELS.indexOf(a.level) - PRANAYAMA_LEVELS.indexOf(b.level) ||
      a.name.localeCompare(b.name, 'en'),
  );

const usedCategories = PRANAYAMA_CATEGORIES.filter((c) => techniques.some((t) => t.category === c));
const usedLevels = PRANAYAMA_LEVELS.filter((l) => techniques.some((t) => t.level === l));
const countByCategory = usedCategories.map((category) => ({
  category,
  count: techniques.filter((t) => t.category === category).length,
}));
---

<PageLayout
  title={config.title}
  description={config.description}
  heading="Pranayama"
  eyebrow="Mind · Breath"
  lede={`${techniques.length} classical breathing techniques with their Sanskrit names, rhythms, benefits, and mandatory safety notes. The tradition's one rule frames them all, the breath is never forced, and what is powerful is learned from a teacher.`}
  path={config.routePrefix}
  accent="indigo"
  jsonLd={[
    websiteJsonLd(SITE),
    breadcrumbJsonLd(SITE.url, [
      { name: 'Home', path: '/' },
      { name: 'Mind', path: '/mind/' },
      { name: config.title, path: config.routePrefix },
    ]),
  ]}
>
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <div id="technique-filters" hidden class="mb-6 rounded-2xl border border-sand bg-parchment/60 p-5">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div>
            <label for="filter-dosha" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Dosha</label>
            <select id="filter-dosha" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any dosha</option>
              {DOSHAS.map((dosha) => (
                <option value={dosha}>Balances {doshaLabel[dosha]}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-category" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Effect</label>
            <select id="filter-category" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any effect</option>
              {usedCategories.map((category) => (
                <option value={category}>{categoryLabel[category]}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-level" class="mb-1 block text-xs font-semibold tracking-wide text-earth uppercase">Level</label>
            <select id="filter-level" class="w-full rounded-lg border border-sand bg-cream px-3 py-2 text-sm text-earth">
              <option value="">Any level</option>
              {usedLevels.map((level) => (
                <option value={level}>{levelLabel[level]}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="mt-4 flex items-center justify-between gap-4">
          <p id="technique-count" role="status" aria-live="polite" class="text-sm text-clay">
            Showing all {techniques.length} techniques
          </p>
          <button
            type="button"
            id="filter-clear"
            class="rounded-lg border border-sand bg-cream px-3 py-1.5 text-xs font-semibold text-earth transition-colors hover:border-indigo/60 hover:text-indigo-deep disabled:cursor-not-allowed disabled:opacity-50"
          >
            Clear filters
          </button>
        </div>
        <p id="quiz-applied-note" hidden class="mt-2 text-xs leading-relaxed text-clay">
          Filtered to your saved dosha-quiz result, adjust the dosha above, or retake the quiz to change it.
        </p>
      </div>

      <noscript>
        <p class="mb-6 rounded-2xl border border-sand bg-parchment/60 p-4 text-sm leading-relaxed text-clay">
          JavaScript is off, so all {techniques.length} techniques are listed below, browse the full collection.
        </p>
      </noscript>

      <ul id="technique-grid" role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {techniques.map((technique) => <TechniqueCard technique={technique} />)}
      </ul>

      <div class="mt-10">
        <Disclaimer variant="pranayama" />
      </div>
    </div>

    <aside class="h-fit space-y-6 lg:sticky lg:top-6">
      <div class="rounded-2xl border border-plum/30 bg-plum/5 p-6">
        <h2 class="font-display text-base font-semibold text-earth">Read this first</h2>
        <ul role="list" class="mt-3 space-y-2 text-sm leading-relaxed text-earth">
          <li>Never strain the breath, the practice ends comfortable, or it has not begun.</li>
          <li>Practise on an empty stomach, sitting tall, through the nose unless a technique says otherwise.</li>
          <li>Dizziness, ringing ears or anxiety; stop and breathe normally.</li>
          <li>Practices marked <em>learn with a teacher</em> are described here for understanding, not for solo attempt.</li>
        </ul>
      </div>

      {isModuleEnabled('quiz') && (
        <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
          <h2 class="font-display text-base font-semibold text-earth">Which breath suits you?</h2>
          <p class="mt-2 text-sm leading-relaxed text-clay">
            Your dosha points to the breaths that steady you, the quiz result filters this page
            automatically, on this device only.
          </p>
          <a
            href="/quiz/"
            class="mt-4 inline-block rounded-xl bg-indigo-deep px-5 py-2.5 text-sm font-semibold text-cream transition-colors hover:bg-earth"
          >
            Take the dosha quiz
          </a>
        </div>
      )}

      {isModuleEnabled('yoga') && (
        <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
          <h2 class="font-display text-base font-semibold text-earth">Seat first, breath second</h2>
          <p class="mt-2 text-sm leading-relaxed text-clay">
            The breath sits best in a steady posture, the asana database includes the classic seats.
          </p>
          <ul role="list" class="mt-3 space-y-1.5 text-sm">
            <li>
              <a href="/body/yoga/sukhasana/" class="font-medium text-saffron-deep underline decoration-saffron/60 underline-offset-2 hover:decoration-saffron-deep">Sukhāsana, the easy seat</a>
            </li>
            <li>
              <a href="/body/yoga/vajrasana/" class="font-medium text-saffron-deep underline decoration-saffron/60 underline-offset-2 hover:decoration-saffron-deep">Vajrāsana, the thunderbolt seat</a>
            </li>
            <li>
              <a href="/body/yoga/padmasana/" class="font-medium text-saffron-deep underline decoration-saffron/60 underline-offset-2 hover:decoration-saffron-deep">Padmāsana, the lotus seat</a>
            </li>
          </ul>
        </div>
      )}

      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">By effect</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {
            countByCategory.map(({ category, count }) => (
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-clay">{categoryLabel[category]}</dt>
                <dd class="font-semibold text-earth">{count}</dd>
              </div>
            ))
          }
          <div class="flex items-baseline justify-between gap-4 border-t border-sand pt-2">
            <dt class="text-clay">Total</dt>
            <dd class="font-semibold text-earth">{techniques.length}</dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</PageLayout>

<script>
  import { mountTechniqueFilters } from '../components/TechniqueFilters';
  mountTechniqueFilters(document.getElementById('technique-filters'));
</script>
