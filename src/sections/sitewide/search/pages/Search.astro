---
/**
 * Search page, the server renders the input, a results region and a
 * no-JS fallback (browse via pillars); the island loads the Pagefind
 * runtime from /pagefind/ (built after `astro build`) and searches the
 * whole rendered site. Routed via src/pages/search/index.astro.
 */
import PageLayout from '../../../../shared/layouts/PageLayout.astro';
import { websiteJsonLd, breadcrumbJsonLd } from '../../../../shared/seo/jsonld';
import { SITE } from '../../../../config/site';
import { enabledModules, pillars } from '../../../../config/sections';
import config from '../module.config';

const live = enabledModules(undefined);
---

<PageLayout
  title={config.title}
  description={config.description}
  heading="Search Satvik.fyi"
  eyebrow="Sitewide · Search"
  lede="Every recipe, asana, herb, breathing technique, meditation, mantra, path, essay and wiki article: one box, instant results, and nothing sent anywhere: the index lives in your browser after the first load."
  path={config.routePrefix}
  noindex={true}
  accent="sage"
  jsonLd={[
    websiteJsonLd(SITE),
    breadcrumbJsonLd(SITE.url, [
      { name: 'Home', path: '/' },
      { name: config.title, path: config.routePrefix },
    ]),
  ]}
>
  <div id="search-root" class="mt-8 max-w-3xl">
    <div class="relative">
      <label for="search-input" class="mb-2 block text-sm font-semibold text-earth">
        Search the whole site
      </label>
      <div class="flex items-center gap-2 rounded-2xl border border-sand bg-cream p-2 pl-5 focus-within:border-sage/60">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-clay" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        </svg>
        <input
          id="search-input"
          type="search"
          name="q"
          autocomplete="off"
          placeholder="Try “kitchari”, “vāta”, “trāṭaka”, “Gāyatrī”…"
          class="w-full bg-transparent py-2 text-base text-earth placeholder:text-clay/70 focus:outline-none"
          aria-describedby="search-status"
        />
      </div>
      <p id="search-status" role="status" aria-live="polite" class="mt-3 min-h-6 text-sm font-medium text-sage-deep"></p>
    </div>

    <noscript>
      <div class="mt-4 rounded-2xl border border-sand bg-parchment/60 p-6 text-sm leading-relaxed text-clay">
        <p class="mb-3">
          <strong class="font-semibold text-earth">JavaScript is off, so instant search is unavailable.</strong>
          The index itself is built from the whole site, you can still browse everything by pillar:
        </p>
        <ul role="list" class="flex flex-wrap gap-2">
          {
            pillars.map((pillar) => (
              <li>
                <a
                  href={pillar.routePrefix}
                  class="inline-flex items-center rounded-full bg-sage/15 px-3 py-1 font-medium text-sage-deep hover:bg-sage/25"
                >
                  {pillar.title}
                </a>
              </li>
            ))
          }
          {
            live.map((module) => (
              <li>
                <a
                  href={module.routePrefix}
                  class="inline-flex items-center rounded-full border border-sand px-3 py-1 font-medium text-earth hover:border-sage/60"
                >
                  {module.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </noscript>

    <ul id="search-results" role="list" class="mt-4 grid grid-cols-1 gap-4" aria-label="Search results"></ul>

    <p class="mt-10 text-xs leading-relaxed text-clay">
      The search index is generated when the site is built and loaded here once, after that it works
      offline. Nothing you type is transmitted: all searching happens on this page, in your browser.
    </p>
  </div>
</PageLayout>

<script>
  import { mountSearch } from '../components/SearchIsland';
  mountSearch(document.getElementById('search-root'));
</script>
