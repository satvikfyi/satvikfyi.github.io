---
/**
 * Blog listing, newest first, tags linked to their tag pages, RSS linked.
 * Zero client JavaScript. Routed via src/pages/blog/index.astro.
 */
import PageLayout from '../../../../shared/layouts/PageLayout.astro';
import { websiteJsonLd, breadcrumbJsonLd } from '../../../../shared/seo/jsonld';
import { SITE } from '../../../../config/site';
import PostCard from '../components/PostCard.astro';
import { publishedPosts, tagCounts } from '../lib/posts';
import config from '../module.config';

const posts = await publishedPosts();
const tags = await tagCounts();
---

<PageLayout
  title={config.title}
  description={config.description}
  heading="The Satvik.fyi Blog"
  eyebrow="Sitewide · Blog"
  lede="Essays and working notes on living satvik today: the food, the breath, the practice, and the traditions behind them. Subscribe via RSS or the newsletter; everything here is free and untracked."
  path={config.routePrefix}
  accent="sage"
  jsonLd={[
    websiteJsonLd(SITE),
    breadcrumbJsonLd(SITE.url, [
      { name: 'Home', path: '/' },
      { name: config.title, path: config.routePrefix },
    ]),
  ]}
>
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-2">
      {
        posts.length > 0 ? (
          <ul role="list" class="grid grid-cols-1 gap-6">
            {posts.map((post) => (
              <PostCard post={post.data} />
            ))}
          </ul>
        ) : (
          <p class="rounded-2xl border border-dashed border-sand bg-parchment/50 p-8 text-sm leading-relaxed text-clay">
            No posts yet, the first essays are being written. The RSS feed below will carry them the
            moment they land.
          </p>
        )
      }
    </div>

    <aside class="h-fit space-y-6 lg:sticky lg:top-6">
      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">Stay in touch</h2>
        <p class="mt-2 text-sm leading-relaxed text-clay">
          Follow along in your reader via RSS, or get new essays by email through the newsletter; 
          free, and no trackers either way.
        </p>
        <div class="mt-4 flex flex-col gap-2 text-sm">
          <a
            href="/rss.xml"
            class="rounded-xl bg-sage-deep px-4 py-2.5 text-center font-semibold text-cream transition-colors hover:bg-earth"
          >
            RSS feed
          </a>
          <a
            href={SITE.footer.elsewhere[0].href || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-sand bg-cream px-4 py-2.5 text-center font-semibold text-earth transition-colors hover:border-sage/60 hover:text-sage-deep"
          >
            Newsletter on Substack
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>

      <div class="rounded-2xl border border-sand bg-parchment/60 p-6">
        <h2 class="font-display text-base font-semibold text-earth">Browse by tag</h2>
        <ul role="list" class="mt-3 flex flex-wrap gap-2">
          {
            tags.map(({ tag, count }) => (
              <li>
                <a
                  href={`/blog/tag/${tag}/`}
                  class="inline-flex items-center gap-1 rounded-full bg-sage/15 px-2.5 py-0.5 text-xs font-medium text-sage-deep hover:bg-sage/25"
                >
                  #{tag}
                  <span class="text-sage-deep/60">{count}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</PageLayout>
