---
// Route entry for /mind/pranayama/, delegates to the pranayama module.
// Registry guard: a disabled module redirects to its parent pillar instead
// of rendering, so flipping `enabled: false` removes it cleanly.
import Index from '../../../sections/mind/pranayama/pages/Index.astro';
import { isModuleEnabled } from '../../../config/sections';

if (!isModuleEnabled('pranayama')) {
  return Astro.redirect('/mind/', 302);
}
